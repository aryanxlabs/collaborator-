# Supabase connection for the frontend (direct, no backend server).
# Find both values in the Supabase dashboard → Project Settings → API:
#   VITE_SUPABASE_URL       = Project URL, e.g. https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY  = anon public key (the publishable client key)
# Leave them empty for a local build with no database; the showcase will
# show a "Supabase database is unreachable" error instead of listings.
# In production (Vercel) set the same two values under
# Project Settings → Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
