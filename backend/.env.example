# Copy this file to .env and fill in your own values.
# Never commit a real .env file to version control.
# Supabase Postgres connection string:
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Use the direct connection (port 5432) or the pooler (port 6543); either works.
# Keep ?sslmode=require in the URL.
DATABASE_URL=postgresql://postgres:<password>@db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
PORT=5000
